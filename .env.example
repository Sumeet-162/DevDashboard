# Supabase Configuration
# You need to replace these with your actual Supabase project values
# Get these from your Supabase dashboard: https://supabase.com/dashboard

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Example:
# VITE_SUPABASE_URL=https://xyzcompany.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# GitHub OAuth Configuration
# Get these values from: https://github.com/settings/applications/new

VITE_GITHUB_CLIENT_ID=your_github_client_id_here
VITE_GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Note: In production, the client secret should be handled by your backend server
# for security reasons. This is for development/demo purposes only.

# Instructions to set up GitHub OAuth:
# 1. Go to https://github.com/settings/applications/new
# 2. Create a new OAuth App with these settings:
#    - Application name: DevDash (or your app name)
#    - Homepage URL: http://localhost:5173 (or your domain)
#    - Authorization callback URL: http://localhost:5173/auth/github/callback
# 3. Copy the Client ID and Client Secret to this file
# 4. Rename this file to .env.local
